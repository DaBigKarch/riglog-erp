<odoo>

    <record id="view_stock_picking_form_riglog_materials" model="ir.ui.view">
        <field name="name">stock.picking.form.riglog.materials</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button
                    name="action_create_riglog_handover"
                    string="Create Handover"
                    type="object"
                    class="oe_highlight"
                    invisible="state != 'done' or picking_type_code != 'incoming'"
                />
            </xpath>

        </field>
    </record>

</odoo>
