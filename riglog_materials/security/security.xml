<odoo>

    <record id="module_category_riglog_materials" model="ir.module.category">
        <field name="name">RigLog Materials</field>
        <field name="description">RigLog materials management</field>
        <field name="sequence">40</field>
    </record>

    <record id="riglog_materials_privilege" model="res.groups.privilege">
        <field name="name">Materials</field>
        <field name="category_id" ref="module_category_riglog_materials"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_materials_user" model="res.groups">
        <field name="name">Materials User</field>
        <field name="privilege_id" ref="riglog_materials_privilege"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_materials_manager" model="res.groups">
        <field name="name">Materials Manager</field>
        <field name="privilege_id" ref="riglog_materials_privilege"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_materials_user'))]"/>
    </record>

</odoo>
