<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Window Action -->
    <record id="action_workforce_compliance_cases" model="ir.actions.act_window">
        <field name="name">Compliance Cases</field>
        <field name="res_model">workforce.compliance.case</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Root Menu -->
    <menuitem
        id="menu_workforce_compliance_root"
        name="Workforce Compliance"
        sequence="10"/>

    <!-- Cases Menu -->
    <menuitem
        id="menu_workforce_compliance_cases"
        name="Compliance Cases"
        parent="menu_workforce_compliance_root"
        action="action_workforce_compliance_cases"
        sequence="10"/>

</odoo>
