<odoo>

    <record id="module_category_riglog_hse" model="ir.module.category">
        <field name="name">RigLog HSE</field>
        <field name="description">RigLog Health, Safety and Environment</field>
        <field name="sequence">50</field>
    </record>

    <record id="riglog_hse_privilege" model="res.groups.privilege">
        <field name="name">HSE</field>
        <field name="category_id" ref="module_category_riglog_hse"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_hse_user" model="res.groups">
        <field name="name">HSE User</field>
        <field name="privilege_id" ref="riglog_hse_privilege"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_hse_manager" model="res.groups">
        <field name="name">HSE Manager</field>
        <field name="privilege_id" ref="riglog_hse_privilege"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_hse_user'))]"/>
    </record>

</odoo>
