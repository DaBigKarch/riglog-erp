                    </page>

                    <page string="Corrective Action">

                        <group>
                            <field name="corrective_action"/>
                            <field name="corrective_owner_id"/>
                            <field name="corrective_due_date"/>
                        </group>

                    </page>

                    <page string="Closure">

                        <group>
                            <field name="closed_date"/>
                            <field name="closure_note"/>
                        </group>

                    </page>

                </notebook>

            </sheet>

            <chatter/>

        </form>
    </field>
</record>


<record id="hse_observation_action" model="ir.actions.act_window">
    <field name="name">Safety Observations</field>
    <field name="res_model">riglog.hse.observation</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="hse_observation_view_list"/>
</record>


<record id="riglog_project_view_form_hse_observation" model="ir.ui.view">
    <field name="name">riglog.project.project.form.hse.observation</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.edit_project"/>
    <field name="arch" type="xml">

        <xpath expr="//div[@name='button_box']" position="inside">

            <button
                class="oe_stat_button"
                type="object"
                name="action_view_riglog_hse_observations"
                icon="fa-eye"
                groups="base.group_user"
                invisible="is_template"
            >
                <div class="o_stat_info">
                    <span class="o_stat_value">
                        <field name="riglog_hse_observation_count"/>
                    </span>
                    <span class="o_stat_text">
                        Safety Observations
                    </span>
                </div>
            </button>

        </xpath>

    </field>
</record>


<menuitem
    id="riglog_hse_observation_menu"
    name="Safety Observations"
    parent="riglog_hse_menu_root"
    action="hse_observation_action"
    sequence="20"
/>

</odoo>
