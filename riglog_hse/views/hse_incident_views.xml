            <header>

                <button
                    name="action_start_corrective_action"
                    string="Start Corrective Action"
                    type="object"
                    class="oe_highlight"
                    invisible="state != 'reported'"
                />

                <button
                    name="action_close"
                    string="Close Observation"
                    type="object"
                    class="oe_highlight"
                    invisible="state != 'corrective_action'"
                />

                <button
                    name="action_reset_reported"
                    string="Reset"
                    type="object"
                    invisible="state != 'closed'"
                />

                <field
                    name="state"
                    widget="statusbar"
                    statusbar_visible="reported,corrective_action,closed"
                />

            </header>

            <sheet>

                <div class="oe_title">
                    <h1>
                        <field name="name"/>
                    </h1>
                </div>

                <group>

                    <group>
                        <field name="observation_type"/>
                        <field name="category"/>
                        <field name="severity"/>
                        <field name="observation_date"/>
                        <field name="location"/>
                    </group>

                    <group>
                        <field name="employee_id"/>
                        <field name="reported_by_employee_id"/>
                        <field name="project_id"/>
                    </group>

                </group>

                <notebook>

                    <page string="Observation">

                        <group>
                            <field name="description"/>
