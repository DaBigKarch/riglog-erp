<odoo>

    <record id="hse_incident_view_list" model="ir.ui.view">
        <field name="name">riglog.hse.incident.view.list</field>
        <field name="model">riglog.hse.incident</field>
        <field name="arch" type="xml">
            <list string="HSE Incidents">
                <field name="name"/>
                <field name="incident_type"/>
                <field name="severity" widget="badge"/>
                <field name="incident_date"/>
                <field name="location"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>


    <record id="hse_incident_view_form" model="ir.ui.view">
        <field name="name">riglog.hse.incident.view.form</field>
        <field name="model">riglog.hse.incident</field>
        <field name="arch" type="xml">
            <form string="HSE Incident">

                <header>

                    <button
                        name="action_start_investigation"
                        string="Start Investigation"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'reported'"
                    />

                    <button
                        name="action_start_corrective_action"
                        string="Start Corrective Action"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'investigation'"
                    />

                    <button
                        name="action_close"
                        string="Close Incident"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'corrective_action'"
                    />

                    <button
                        name="action_reset_reported"
                        string="Reset"
                        type="object"
                        invisible="state != 'closed'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="reported,investigation,corrective_action,closed"
                    />

                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group>
                            <field name="incident_type"/>
                            <field name="severity"/>
                            <field name="incident_date"/>
                            <field name="location"/>
                        </group>

                        <group>
                            <field name="employee_id"/>
                            <field name="reported_by_employee_id"/>
                            <field name="project_id"/>
                            <field name="investigator_id"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Incident">

                            <group>
                                <field name="description"/>
                                <field name="immediate_action"/>
                            </group>

                        </page>

                        <page string="Investigation">

                            <group>
                                <field name="investigation_findings"/>
                                <field name="root_cause"/>
                            </group>

                        </page>

                        <page string="Corrective Action">

                            <group>
                                <field name="corrective_action"/>
                                <field name="corrective_owner_id"/>
                                <field name="corrective_due_date"/>
                            </group>

                        </page>

                        <page string="Closure">

                            <group>
                                <field name="closed_date"/>
                                <field name="closure_note"/>
                            </group>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>
        </field>
    </record>


    <record id="hse_incident_view_search" model="ir.ui.view">
        <field name="name">riglog.hse.incident.view.search</field>
        <field name="model">riglog.hse.incident</field>
        <field name="arch" type="xml">
            <search string="HSE Incidents">

                <field name="name"/>
                <field name="incident_type"/>
                <field name="severity"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="state"/>

                <filter
                    name="reported"
                    string="Reported"
                    domain="[('state', '=', 'reported')]"
                />

                <filter
                    name="investigation"
                    string="Investigation"
                    domain="[('state', '=', 'investigation')]"
                />

                <filter
                    name="corrective_action"
                    string="Corrective Action"
                    domain="[('state', '=', 'corrective_action')]"
                />

                <filter
                    name="closed"
                    string="Closed"
                    domain="[('state', '=', 'closed')]"
                />

            </search>
        </field>
    </record>


    <record id="hse_incident_action" model="ir.actions.act_window">
        <field name="name">HSE Incidents</field>
        <field name="res_model">riglog.hse.incident</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="hse_incident_view_list"/>
    </record>


    <record id="riglog_project_view_form_hse" model="ir.ui.view">
        <field name="name">riglog.project.project.form.hse</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">

                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_view_riglog_hse_incidents"
                    icon="fa-exclamation-triangle"
                    groups="base.group_user"
                    invisible="is_template"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="riglog_hse_incident_count"/>
                        </span>
                        <span class="o_stat_text">
                            HSE Incidents
                        </span>
                    </div>
                </button>

            </xpath>

        </field>
    </record>


    <menuitem
        id="riglog_hse_menu_root"
        name="HSE"
        parent="riglog_procurement.riglog_procurement_menu_root"
        sequence="30"
    />

    <menuitem
        id="riglog_hse_incident_menu"
        name="Incidents"
        parent="riglog_hse_menu_root"
        action="hse_incident_action"
        sequence="10"
    />




<record id="hse_observation_view_list" model="ir.ui.view">
    <field name="name">riglog.hse.observation.view.list</field>
    <field name="model">riglog.hse.observation</field>
    <field name="arch" type="xml">
        <list string="Safety Observations">
            <field name="name"/>
            <field name="observation_type"/>
